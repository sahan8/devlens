{
  "manifest_version": 3,
  "name": "DevLens",
  "version": "1.0.0",
  "description": "Inspect website elements and understand their CSS styles.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "action": {
    "default_popup": "index.html",
    "default_title": "DevLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}